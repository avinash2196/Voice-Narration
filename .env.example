# Shared environment variables for local development
# Copy this to .env or .env.local and replace credentials as needed.
DATABASE_URL=postgresql://voice_narration:your_password@localhost:5432/voice_narration
AUDIO_STORAGE_PATH=./audio_storage
AUDIO_RETENTION_DAYS=30
INFERENCE_PROVIDER=google
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8003
VOICE_SERVICE_URL=http://localhost:8002
