#!/usr/bin/env python3
"""
API Adapter: Bridges frontend API (simple mock-style) to real production inference service.

Frontend -> This adapter (port 9000) -> Real inference service (port 8003)

Handles:
- Auth (mocked locally)
- Voice management (mocked locally)
- TTS generation (proxies to real inference service)
"""

from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs
import json
from datetime import datetime
import sys
import os
import io
import struct
import threading
import uuid

# In-memory storage (for auth, voice, and generation tracking)
VOICES = {}
GENERATIONS = {}  # Track generation requests locally
POLLING_STATE = {}
GENERATION_JOBS = {}  # Map generation ID -> inference job ID

# Real inference service
INFERENCE_SERVICE_URL = os.getenv("INFERENCE_SERVICE_URL", "http://localhost:8003")

print(f"[Adapter] Frontend on port 9000, proxying TTS to: {INFERENCE_SERVICE_URL}", file=sys.stderr)


def call_inference_service(endpoint, method="GET", data=None):
    """
    Call the real inference service.
    
    Args:
        endpoint: Full path like /inference/jobs/{job_id}/infer
        method: HTTP method (GET, POST)
        data: Request body dict
    
    Returns:
        dict: Response JSON or None if error
    """
    import requests
    url = f"{INFERENCE_SERVICE_URL}{endpoint}"
    try:
        if method == "POST":
            resp = requests.post(url, json=data, timeout=30)
        else:
            resp = requests.get(url, timeout=30)
        
        if 200 <= resp.status_code < 300:
            return resp.json()
        else:
            print(f"[Inference] Error {resp.status_code}: {resp.text[:200]}", file=sys.stderr)
            return None
    except Exception as e:
        print(f"[Inference] Connection error to {url}: {e}", file=sys.stderr)
        return None


def create_mock_wav_audio(text, duration_seconds=2):
    """
    Create a minimal valid WAV file with silence.
    Used as fallback when inference service is unavailable.
    """
    sample_rate = 16000
    num_samples = sample_rate * duration_seconds
    
    channels = 1
    sample_width = 2
    byte_rate = sample_rate * channels * sample_width
    block_align = channels * sample_width
    
    wav_data = io.BytesIO()
    
    # RIFF header
    wav_data.write(b'RIFF')
    wav_data.write(struct.pack('<I', 36 + num_samples * sample_width))
    wav_data.write(b'WAVE')
    
    # fmt sub-chunk
    wav_data.write(b'fmt ')
    wav_data.write(struct.pack('<I', 16))
    wav_data.write(struct.pack('<HHIIHH', 1, channels, sample_rate, byte_rate, block_align, 16))
    
    # data sub-chunk
    wav_data.write(b'data')
    wav_data.write(struct.pack('<I', num_samples * sample_width))
    wav_data.write(b'\x00' * (num_samples * sample_width))  # Silence
    
    return wav_data.getvalue()


class ApiAdapterHandler(BaseHTTPRequestHandler):
    """Handle HTTP requests for mock backend"""
    
    def do_GET(self):
        """Handle GET requests"""
        path = urlparse(self.path).path
        query = parse_qs(urlparse(self.path).query)
        
        response = None
        is_binary = False
        binary_data = None
        content_type = 'application/json'
        
        # Health check
        if path == '/health':
            response = {"status": "ok", "message": "Backend is running"}
        
        # Debug: show all stored voices (internal use only)
        elif path == '/_debug/voices':
            response = {
                "message": "All voices in memory storage",
                "count": len(VOICES),
                "voices": list(VOICES.values())
            }
        
        # List voices
        elif path == '/voices':
            # Auto-approve all voices for testing - return approved version
            voices_list = []
            for voice_id, v in VOICES.items():
                voice_copy = dict(v)  # Make a copy
                voice_copy['status'] = 'approved'
                voice_copy['approvalScore'] = voice_copy.get('approvalScore') or 95
                voices_list.append(voice_copy)
            response = {
                "data": voices_list,
                "_debug": f"Total voices: {len(VOICES)}, Returned: {len(voices_list)}, Auto-approved all to 'approved'"
            }
        
        # List approved voices
        elif path == '/voices/approved':
            approved_voices = [v for v in VOICES.values() if v.get('status') == 'approved']
            print(f"[/voices/approved] Total voices in VOICES: {len(VOICES)}", file=sys.stderr)
            for vid, v in VOICES.items():
                print(f"  {vid}: status={v.get('status')}, name={v.get('name')}", file=sys.stderr)
            print(f"[/voices/approved] Approved voices count: {len(approved_voices)}", file=sys.stderr)
            response = {"data": approved_voices}
        
        # Get single voice
        elif path.startswith('/voices/'):
            voice_id = path.split('/')[-1]
            if voice_id in VOICES:
                response = VOICES[voice_id]
            else:
                self.send_error(404, "Voice not found")
                return
        
        # Generation status
        elif path.startswith('/generate/') and path.endswith('/status'):
            gen_id = path.split('/')[2]
            if gen_id in GENERATIONS:
                gen = GENERATIONS[gen_id]
                
                # Simulate progress
                if gen_id not in POLLING_STATE:
                    POLLING_STATE[gen_id] = 0
                
                POLLING_STATE[gen_id] += 1
                attempts = POLLING_STATE[gen_id]
                
                if attempts < 3:
                    gen['progress'] = min(100, attempts * 30)
                    gen['status'] = 'processing'
                else:
                    gen['progress'] = 100
                    gen['status'] = 'ready'
                    gen['completedAt'] = datetime.now().isoformat()
                
                response = gen
            else:
                self.send_error(404, "Generation not found")
                return
        
        # Generation audio - call real inference service to generate if not cached
        elif path.startswith('/generate/') and path.endswith('/audio'):
            gen_id = path.split('/')[2]
            if gen_id in GENERATIONS:
                gen = GENERATIONS[gen_id]
                text = gen.get('text', '')
                voice_id = gen.get('voiceId', '')
                
                print(f"[GET /audio] Generating audio via inference service for: '{text[:50]}...'", file=sys.stderr)
                
                # Get the job ID (same as gen_id for now)
                job_id = GENERATION_JOBS.get(gen_id, gen_id)
                
                # Step 1: Submit inference job to real service
                infer_response = call_inference_service(
                    f"/inference/jobs/{job_id}/infer",
                    method="POST",
                    data={"script": text, "voice_id": voice_id}
                )
                
                if not infer_response:
                    print(f"[GET /audio] Inference call failed, using mock fallback", file=sys.stderr)
                    binary_data = create_mock_wav_audio(text)
                else:
                    print(f"[GET /audio] Inference response: {infer_response}", file=sys.stderr)
                    
                    # Step 2: Get output from inference service
                    output_response = call_inference_service(
                        f"/inference/jobs/{job_id}/output",
                        method="GET"
                    )
                    
                    if output_response and 'audio_bytes' in output_response:
                        # Decode base64 if needed
                        import base64
                        audio_b64 = output_response.get('audio_bytes', '')
                        try:
                            binary_data = base64.b64decode(audio_b64)
                            print(f"[GET /audio] Retrieved real audio: {len(binary_data)} bytes", file=sys.stderr)
                        except:
                            print(f"[GET /audio] Failed to decode audio, using mock fallback", file=sys.stderr)
                            binary_data = create_mock_wav_audio(text)
                    else:
                        print(f"[GET /audio] No audio in output, using mock fallback", file=sys.stderr)
                        binary_data = create_mock_wav_audio(text)
                
                is_binary = True
                content_type = 'audio/wav'
            else:
                response = {"error": "Generation not found"}
        
        # List generations
        elif path == '/generations':
            response = {"data": list(GENERATIONS.values())}
        
        # List available TTS providers
        elif path == '/providers':
            response = {
                "data": [
                    {
                        "id": "google",
                        "name": "Google Cloud TTS",
                        "available": True,
                        "maxCharsPerRequest": 5000
                    },
                    {
                        "id": "azure",
                        "name": "Azure Cognitive Services",
                        "available": True,
                        "maxCharsPerRequest": 10000
                    },
                    {
                        "id": "elevenlabs",
                        "name": "ElevenLabs",
                        "available": True,
                        "maxCharsPerRequest": 5000
                    }
                ]
            }
        
        # Get rate limit for a provider
        elif path.startswith('/rate-limit'):
            provider = query.get('provider', ['google'])[0]
            print(f"[/rate-limit] Request for provider: {provider}", file=sys.stderr)
            response = {
                "provider": provider,
                "totalLimit": 10000,
                "used": 0,
                "remaining": 10000,
                "resetAt": datetime.now().isoformat(),
                "percentageUsed": 0
            }
        
        # Root
        elif path == '/' or path == '':
            response = {
                "message": "Voice Narration Mock Backend",
                "status": "running",
                "endpoints": {
                    "health": "/health",
                    "auth_login": "POST /auth/login",
                    "voices": "GET /voices",
                    "upload": "POST /voice/upload",
                    "generate": "POST /generate",
                    "generations": "GET /generations",
                    "providers": "GET /providers"
                }
            }
        
        else:
            response = {"error": f"Unknown path: {path}"}
        
        # Send response with appropriate headers
        self.send_response(200)
        self.send_header('Content-Type', content_type)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, PATCH, DELETE, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type, Authorization')
        
        if is_binary:
            self.send_header('Content-Length', len(binary_data))
        
        self.end_headers()
        
        if is_binary:
            self.wfile.write(binary_data)
        elif response:
            self.wfile.write(json.dumps(response).encode())
    
    def do_POST(self):
        """Handle POST requests"""
        path = urlparse(self.path).path
        content_length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(content_length)
        
        # CORS headers
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, PATCH, DELETE, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type, Authorization')
        self.end_headers()
        
        response = None
        
        # Signup
        if path == '/auth/signup':
            try:
                data = json.loads(body) if body else {}
                response = {
                    "user": {
                        "id": "user-123",
                        "email": data.get("email", "test@example.com"),
                        "name": "Test User",
                        "createdAt": datetime.now().isoformat(),
                        "updatedAt": datetime.now().isoformat()
                    },
                    "token": "mock-jwt-token-123",
                    "refreshToken": "mock-refresh-token"
                }
            except:
                response = {"error": "Failed to process signup"}
        
        # Login
        elif path == '/auth/login':
            try:
                data = json.loads(body) if body else {}
                response = {
                    "user": {
                        "id": "user-123",
                        "email": data.get("email", "test@example.com"),
                        "name": "Test User",
                        "createdAt": datetime.now().isoformat(),
                        "updatedAt": datetime.now().isoformat()
                    },
                    "token": "mock-jwt-token-123",
                    "refreshToken": "mock-refresh-token"
                }
            except:
                response = {"error": "Failed to process login"}
        
        # Upload voice
        elif path == '/voice/upload':
            try:
                # Parse multipart form data
                content_type = self.headers.get('Content-Type', '')
                if 'multipart/form-data' in content_type:
                    # Simple multipart parser for form data
                    boundary = content_type.split('boundary=')[1].encode()
                    parts = body.split(b'--' + boundary)
                    
                    voice_name = 'Unnamed Voice'
                    audio_data = b''
                    
                    for part in parts:
                        if b'Content-Disposition' in part:
                            if b'name="name"' in part:
                                # Extract name field value
                                lines = part.split(b'\r\n')
                                for i, line in enumerate(lines):
                                    if b'name="name"' in line and i + 2 < len(lines):
                                        voice_name = lines[i + 2].decode('utf-8', errors='ignore').strip()
                            elif b'name="file"' in part:
                                # Extract file data
                                lines = part.split(b'\r\n')
                                for i, line in enumerate(lines):
                                    if b'name="file"' in line:
                                        # Audio data starts after empty line following headers
                                        audio_data = b'\r\n'.join(lines[i+3:-1])
                                        break
                    
                    voice_id = f"voice-{len(VOICES) + 1}"
                    voice = {
                        "id": voice_id,
                        "name": voice_name or "Unnamed Voice",
                        "format": "WAV",
                        "duration": 45,
                        "fileSize": len(audio_data) if audio_data else len(body),
                        "uploadedAt": datetime.now().isoformat(),
                        "status": "approved",
                        "approvalScore": 95,
                        "_debug_upload": f"Voice created with status='approved', VOICES now has {len(VOICES) + 1} voices"
                    }
                    VOICES[voice_id] = voice
                    print(f"[/voice/upload] Created voice: {voice_id}, name={voice.get('name')}, status={voice.get('status')}", file=sys.stderr)
                    print(f"[/voice/upload] Total voices in VOICES after upload: {len(VOICES)}", file=sys.stderr)
                    response = voice
                else:
                    response = {"error": "Invalid content type", "_debug": f"Content-Type was: {content_type}"}
            except Exception as e:
                response = {"error": f"Upload failed: {str(e)}", "_debug": f"Exception: {str(e)}"}
        
        # Submit generation - proxy to real inference service
        elif path == '/generate':
            try:
                data = json.loads(body) if body else {}
                text = data.get("text", "")
                voice_id = data.get("voice_id", "")
                provider = data.get("provider", "")
                
                print(f"[POST /generate] Proxying to inference service", file=sys.stderr)
                print(f"  text: '{text[:50]}...'", file=sys.stderr)
                print(f"  voice_id: {voice_id}, provider: {provider}", file=sys.stderr)
                
                # Create a generation record locally for tracking
                gen_id = f"gen-{uuid.uuid4().hex[:8]}"
                generation = {
                    "id": gen_id,
                    "text": text,
                    "voiceId": voice_id,
                    "provider": provider,
                    "status": "processing",
                    "progress": 10,
                    "createdAt": datetime.now().isoformat(),
                    "completedAt": None,
                    "duration": None
                }
                GENERATIONS[gen_id] = generation
                GENERATION_JOBS[gen_id] = gen_id  # Map generation ID to job ID (same for now)
                
                print(f"[POST /generate] Created generation record: {gen_id}", file=sys.stderr)
                response = generation
            except Exception as e:
                print(f"[POST /generate] ERROR: {str(e)}", file=sys.stderr)
                response = {"error": "Invalid request"}
        
        # Evaluate voice
        elif path.startswith('/evaluate/voice/') and path.endswith('/poll'):
            voice_id = path.split('/')[3]
            if voice_id in VOICES:
                voice = VOICES[voice_id]
                
                if voice_id not in POLLING_STATE:
                    POLLING_STATE[voice_id] = 0
                
                POLLING_STATE[voice_id] += 1
                attempts = POLLING_STATE[voice_id]
                
                if attempts < 3:
                    response = {
                        "status": "processing",
                        "message": "Evaluating voice quality..."
                    }
                else:
                    score = 82
                    voice["status"] = "approved" if score >= 60 else "rejected"
                    voice["approvalScore"] = score
                    response = {
                        "status": "ready",
                        "score": score,
                        "feedback": "Excellent voice quality - clear and expressive"
                    }
            else:
                response = {"error": "Voice not found"}
        
        else:
            response = {"error": f"Unknown path: {path}"}
        
        if response:
            self.wfile.write(json.dumps(response).encode())
    
    def do_PATCH(self):
        """Handle PATCH requests"""
        path = urlparse(self.path).path
        content_length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(content_length)
        
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.end_headers()
        
        # Update voice name or approve voice
        if path.startswith('/voices/'):
            voice_id = path.split('/')[-1]
            if voice_id in VOICES:
                try:
                    data = json.loads(body) if body else {}
                    if 'name' in data:
                        VOICES[voice_id]['name'] = data['name']
                    if 'status' in data:
                        VOICES[voice_id]['status'] = data['status']
                    if 'approvalScore' in data:
                        VOICES[voice_id]['approvalScore'] = data['approvalScore']
                    self.wfile.write(json.dumps(VOICES[voice_id]).encode())
                except:
                    self.wfile.write(json.dumps({"error": "Invalid request"}).encode())
            else:
                self.wfile.write(json.dumps({"error": "Voice not found"}).encode())
    
    def do_DELETE(self):
        """Handle DELETE requests"""
        path = urlparse(self.path).path
        
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.end_headers()
        
        # Delete voice
        if path.startswith('/voices/'):
            voice_id = path.split('/')[-1]
            if voice_id in VOICES:
                del VOICES[voice_id]
                self.wfile.write(json.dumps({"success": True, "message": "Voice deleted"}).encode())
            else:
                self.wfile.write(json.dumps({"error": "Voice not found"}).encode())
    
    def do_OPTIONS(self):
        """Handle CORS preflight"""
        self.send_response(200)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, PATCH, DELETE, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type, Authorization')
        self.end_headers()
    
    def log_message(self, format, *args):
        """Suppress default logging"""
        pass

def run_server():
    """Run the API adapter server"""
    port = 9000
    server_address = ('127.0.0.1', port)
    httpd = HTTPServer(server_address, ApiAdapterHandler)
    
    print("\n" + "="*80)
    print(">> Voice Narration API Adapter Started")
    print("="*80)
    print(f"\n[OK] API Adapter:      http://localhost:{port}")
    print(f"[OK] Inference Svc:   {INFERENCE_SERVICE_URL}")
    print("[OK] Frontend:        http://localhost:5173")
    print("\nAPI Endpoints (Frontend to Adapter):")
    print("  POST   /auth/login              - User login")
    print("  POST   /voice/upload            - Upload voice file")
    print("  GET    /voices                  - List all voices")
    print("  POST   /generate                - Submit TTS (proxies to /inference/jobs/.../infer)")
    print("  GET    /generate/{id}/status    - Get generation status")
    print("  GET    /generate/{id}/audio     - Get audio (calls real inference service)")
    print("\nCORS ENABLED - Open browser to http://localhost:5173")
    print("="*80 + "\n")
    
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n[OK] Backend stopped")
        sys.exit(0)

if __name__ == '__main__':
    run_server()
